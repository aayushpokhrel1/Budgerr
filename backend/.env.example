DATABASE_URL=postgresql+psycopg://budgerr:budgerr@localhost:5433/budgerr

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

CORS_ORIGINS=http://localhost:8081,http://localhost:3000,https://aayushpokhrel1.github.io

PLAYSTAT_BASE_URL=http://localhost:8000

ANTHROPIC_API_KEY=
# playstat API key (required once playstat's AUTH_ENABLED is on; provision a
# "budgerr" entry in playstat's PLAYSTAT_API_KEYS and mirror the key here)
PLAYSTAT_API_KEY=

# Set to true/1/yes to require X-API-Key on every Budgerr API request.
# Unset (or any other value) disables auth entirely.
AUTH_ENABLED=false
# Comma-separated "name:key" pairs, e.g. "web:abc123,mobile:def456,cron:ghi789".
# Names are bookkeeping only (per-consumer revocation); clients send their
# key in the X-API-Key request header.
BUDGERR_API_KEYS=
